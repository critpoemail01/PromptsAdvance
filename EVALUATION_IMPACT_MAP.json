{
  "schemaVersion": 1,
  "policy": {
    "targetedOnEveryChange": true,
    "fullSuiteRequiredForStablePromotion": true,
    "fullSuiteCaseIds": ["EVAL-01", "EVAL-02", "EVAL-03", "EVAL-04", "EVAL-05", "EVAL-06", "EVAL-07", "EVAL-08", "EVAL-09", "EVAL-10", "EVAL-11", "EVAL-12", "EVAL-13", "EVAL-14", "EVAL-15"]
  },
  "rules": [
    {
      "name": "lifecycle-and-common-contract",
      "pathRegex": "^(software-lifecycle\\.ps1|PROCESS_MANIFEST\\.json|AGENTS\\.md|EXECUTION_CONTRACT\\.md|\\.agents/skills/)",
      "cases": ["EVAL-03", "EVAL-04", "EVAL-11", "EVAL-12", "EVAL-13"]
    },
    {
      "name": "discovery",
      "pathRegex": "(^|/)01-descobrir-nova-ideia-de-app\\.md$",
      "cases": ["EVAL-01", "EVAL-12"]
    },
    {
      "name": "naming",
      "pathRegex": "(^|/)02-.*nome.*\\.md$",
      "cases": ["EVAL-14", "EVAL-12"]
    },
    {
      "name": "requirements-and-gate-a",
      "pathRegex": "(^|/)(03-levantar-requisitos-funcionais|04-identificar-requisitos-em-falta)\\.md$|^(PRODUCT_DEFINITION\\.md|HELP_AND_ACADEMY\\.md)$",
      "cases": ["EVAL-11", "EVAL-15"]
    },
    {
      "name": "visual-experience",
      "pathRegex": "^(PRODUCT_EXCELLENCE\\.md|PRODUCT_QUALITY_BASELINE\\.md)$|^prompts/03-marca-e-layout/",
      "cases": ["EVAL-05", "EVAL-07"]
    },
    {
      "name": "vertical-slices",
      "pathRegex": "^prompts/04-backend-e-funcionalidades/",
      "cases": ["EVAL-02", "EVAL-06", "EVAL-08", "EVAL-10"]
    },
    {
      "name": "security-data-and-release",
      "pathRegex": "^prompts/(05-seguranca-e-privacidade|08-qualidade-e-hardening|09-entrega-e-distribuicao|11-aceitacao-e-manutencao)/|^QUALITY_GATES\\.md$",
      "cases": ["EVAL-03", "EVAL-08", "EVAL-09", "EVAL-10", "EVAL-13"]
    },
    {
      "name": "evaluation-harness",
      "pathRegex": "^(PROMPT_EVALUATION\\.md|PILOT_APPROVAL\\.md|EVALUATION_IMPACT_MAP\\.json|pilot/|scripts/(Invoke-PromptPilotCase|Test-PromptPilot|Test-ImplementationReadinessGate))",
      "cases": ["EVAL-01", "EVAL-03", "EVAL-11", "EVAL-13", "EVAL-14", "EVAL-15"]
    }
  ],
  "fallbackCases": ["EVAL-02"]
}
